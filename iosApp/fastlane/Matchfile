# Matchfile - encrypted distribution of iOS signing artifacts for Kropia.
#
# Use the same private match repo as the other AppToLast apps that belong to
# the same Apple Developer Team. match separates profiles by bundle id.

git_url(ENV["MATCH_GIT_URL"]) unless ENV["MATCH_GIT_URL"].to_s.empty?

storage_mode("git")

app_identifier(["com.apptolast.greenhousefronts"])

team_id(ENV["FASTLANE_TEAM_ID"]) unless ENV["FASTLANE_TEAM_ID"].to_s.empty?

type("appstore")
