# iosApp/fastlane/.env.example
#
# Copy this file to `iosApp/fastlane/.env` (gitignored) for local runs.
# CI should provide the same values through GitHub Actions Secrets.

# Apple Developer / App Store Connect identity.
APPLE_ID=you@example.com
FASTLANE_TEAM_ID=ABCDE12345
FASTLANE_ITC_TEAM_ID=987654321

# App Store Connect API key.
# Generate in App Store Connect -> Users and Access -> Keys.
APP_STORE_CONNECT_API_KEY_ID=ABCDEF1234
APP_STORE_CONNECT_API_KEY_ISSUER_ID=12345678-1234-1234-1234-123456789012
ASC_API_KEY_PATH=/absolute/path/to/AuthKey_ABCDEF1234.p8

# match signing repository.
# Reuse the shared private AppToLast match repo that already contains Fliksy.
MATCH_GIT_URL=https://github.com/apptolast/ios-certificates.git
MATCH_PASSWORD=replace-me-with-a-strong-passphrase

# CI only: base64 of "github-username:PAT" for pulling the private match repo.
MATCH_GIT_BASIC_AUTHORIZATION=
